# Server port
PORT=3000

# MentraOS
PACKAGE_NAME=org.yourname.appname
MENTRAOS_API_KEY=your_api_key_here
COOKIE_SECRET=

# Voice Agent — Python backend URL (used by Bun WS proxy)
PYTHON_VOICE_URL=ws://localhost:8000

# Qwen3-TTS model (default: Qwen/Qwen3-TTS-0.6B)
TTS_MODEL=Qwen/Qwen3-TTS-0.6B

# Activation timeout in seconds (leaky window)
ACTIVATION_TIMEOUT=15.0

# Load TTS model on startup (set to 0 to defer for faster boot)
LOAD_TTS_ON_START=1

# Optional LLM backend for response generation
# LLM_ENDPOINT=https://api.anthropic.com/v1/messages
# LLM_API_KEY=your_key_here
# LLM_MODEL=claude-haiku-4-5-20251001
